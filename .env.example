# ==============================================================================
# .env.example — copy thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# (`.env` đã nằm trong .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# DEV1 — Go engine (online serving). KHÔNG cần secret nào để chạy core.
# Đây là config runtime, không phải bí mật. Có thể bỏ trống để dùng mặc định.
# ------------------------------------------------------------------------------
PORT=8000
KB_DIR=build
# UI_DIST=../ui/dist        # bỏ comment để Go serve frontend tĩnh cùng origin (prod)

# ------------------------------------------------------------------------------
# Qwen / DashScope — LLM + Vision + Embedding (DEV3 vision.go/assistant + Python).
# Base URL OpenAI-compatible. Key build-week HẾT HẠN 14/7 — nhớ thu hồi sau đó.
# ------------------------------------------------------------------------------
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus              # xác nhận tên model theo docs QwenCloud
QWEN_VL_MODEL=qwen-vl-plus        # dish recognition + menu OCR
QWEN_EMBED_MODEL=text-embedding-v3

# ------------------------------------------------------------------------------
# Fallback LLM (optional) — dùng khi Qwen hết quota / rate-limit.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Generic LLM_* — engine/llm.go reads these first, falling back to DASHSCOPE_*/
# QWEN_* above if unset. All 3 providers below speak the same OpenAI
# chat-completions JSON shape (incl. multimodal image_url for vision), so
# swapping provider = uncommenting a preset here, no code change needed.
# ------------------------------------------------------------------------------

# -- Preset: DashScope/Qwen (default, matches DASHSCOPE_* above) --
# LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=qwen-plus
# LLM_VL_MODEL=qwen-vl-plus

# -- Preset: Gemini (OpenAI-compatible endpoint) --
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=<gemini-api-key>
# LLM_MODEL=gemini-2.0-flash
# LLM_VL_MODEL=gemini-2.0-flash

# -- Preset: OpenAI --
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_VL_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Qdrant (vector DB, optional semantic search layer — DEV3 vectordb.go).
# Leave QDRANT_URL empty to disable: engine falls back to pure lexical
# token-match, unchanged from default. `./scripts/setup_qdrant.sh` starts a
# local Qdrant via Docker and prints the URL to put here.
# ------------------------------------------------------------------------------
QDRANT_URL=
QDRANT_COLLECTION=tascop11_pois

# ------------------------------------------------------------------------------
# Postgres (optional layer — internal/db): end-user accounts, sessions, UGC
# contributor attribution, saved trip contexts. Leave DATABASE_URL empty to
# disable: auth/context routes degrade to a clear 503 feature_disabled, and
# the core recommend/contribute paths are entirely unaffected (they stay on
# the existing flat-file kb.json/contributions.json regardless).
# `docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16` is
# enough for local dev; engine/internal/db/migrations runs automatically on boot.
# ------------------------------------------------------------------------------
DATABASE_URL=
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/tascop11?sslmode=disable

# ------------------------------------------------------------------------------
# Enrichment / scraping (optional, DEV2 nice-to-have — §6.5 PLAN).
# Chỉ cần nếu chạy làn scrape POI thật; core + UGC không cần.
# ------------------------------------------------------------------------------
APIFY_TOKEN=
ZENROWS_API_KEY=
TAVILY_API_KEY=
