{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasco-restaurant-intelligence-api",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tasco-restaurant-intelligence",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "tasco-restaurant-artifacts",
    },
  ],
  "vectorize": [
    {
      "binding": "RESTAURANT_SEARCH",
      "index_name": "restaurant-search",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "SOURCE_INGESTION_QUEUE",
        "queue": "source-ingestion",
      },
      {
        "binding": "INDEXING_QUEUE",
        "queue": "restaurant-indexing",
      },
      {
        "binding": "DEAD_LETTER_QUEUE",
        "queue": "restaurant-intelligence-dlq",
      },
    ],
    "consumers": [
      {
        "queue": "source-ingestion",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "restaurant-intelligence-dlq",
      },
      {
        "queue": "restaurant-indexing",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "restaurant-intelligence-dlq",
      },
    ],
  },
  "vars": {
    "APP_ENV": "development",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "GENERATION_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "VISION_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "RERANKER_MODEL": "",
    "TRANSCRIPTION_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "ENABLE_AI_SEARCH": "false",
    "MAX_UPLOAD_BYTES": "20971520",
    "ALLOWED_SOURCE_DOMAINS": "",
  },
}
