# Go engine (our own backend, cmd/server) — the primary backend for this app.
# Serves /v1/recommend, /v1/poi, /v1/compare, /v1/assistant, /v1/contribute(/menu),
# /v1/dishes/recognize, /v1/enrich, AND the map-service surface (search/
# autocomplete/nearby-search/geocoding/reverse-geocoding) that lib/tasco-maps-client.ts
# also targets by default. Leave unset to keep the demo purely offline (falls
# back to the local mock ranker / mock enrichment schedule).
VITE_ENGINE_BASE_URL=http://localhost:8000

# Optional override: point lib/tasco-maps-client.ts's map-service calls
# (search/autocomplete/nearby-search/geocoding/reverse-geocoding) at a
# DIFFERENT facade than the engine above — e.g. a staging/production hackathon
# endpoint, or the original localhost:8787 mock server. Takes priority over
# VITE_ENGINE_BASE_URL when set.
# VITE_TASCO_MAPS_BASE_URL=http://localhost:8787
# VITE_TASCO_MAPS_BASE_URL=https://hackathon.example.com/v1
# VITE_TASCO_MAPS_BASE_URL=https://tasco-maps.dnpwater.vn

# Do NOT commit real .env files — this file is a template only.
