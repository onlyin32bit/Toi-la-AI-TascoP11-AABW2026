# Tasco Maps AI Hackathon API base URL.
# The client falls back to http://localhost:8787 (mock server) if unset.
# Do NOT commit real .env files — this file is a template only.

# Mock server (local dev):
# VITE_TASCO_MAPS_BASE_URL=http://localhost:8787

# Recommended hackathon facade:
# VITE_TASCO_MAPS_BASE_URL=https://hackathon.example.com/v1

# Production geocode/route bases (if targeting the current production edges):
# VITE_TASCO_MAPS_BASE_URL=https://tasco-maps.dnpwater.vn
